# Port this service listens on
PORT=8000

# OpenAI
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-4o-mini

# Shared secret that the Node backend sends as the X-API-Key header.
# Must match AI_SERVICE_API_KEY in backend/.env
AI_SERVICE_API_KEY=replace_with_shared_secret_between_backend_and_ai_service
